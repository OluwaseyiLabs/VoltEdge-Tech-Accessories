# ==========================================
# VoltEdge Environment Configuration Template
# (Placeholders only - never commit real secret keys)
# ==========================================

# Backend Webhook Destinations (Protected from client exposure)
VOLTEDGE_ORDER_WEBHOOK_URL=https://your-n8n-instance.com/webhook/voltedge-order
VOLTEDGE_ORDER_DETAILS_WEBHOOK_URL=https://your-n8n-instance.com/webhook/voltedge-order-details
VOLTEDGE_FEEDBACK_WEBHOOK_URL=

# Optional Backend Secret Headers (if n8n requires authentication)
VOLTEDGE_API_KEY=

# Local Development Server Port
PORT=8000

# ==========================================
# Supabase CMS & Inventory Database Configuration
# ==========================================
# Obtain from Supabase Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-never-expose-to-browser

# ==========================================
# Rate Limiting Configuration
# ==========================================
# Upstash Redis REST Credentials (Required for distributed multi-instance rate limiting on Vercel)
# Obtain from https://console.upstash.com -> Redis Database -> REST API
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Configurable Limits & Window Durations (Defaults provided below)
RATE_LIMIT_ORDER_MAX=5
RATE_LIMIT_ORDER_WINDOW_SEC=60

RATE_LIMIT_LOOKUP_MAX=20
RATE_LIMIT_LOOKUP_WINDOW_SEC=60

RATE_LIMIT_FEEDBACK_MAX=5
RATE_LIMIT_FEEDBACK_WINDOW_SEC=60
